# NVIDIA NIM OpenAI-compatible endpoint
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=PASTE_YOUR_NVIDIA_API_KEY_HERE

# Optional individual keys; blank means use NVIDIA_API_KEY
ORCHESTRATOR_API_KEY=
PLANNER_API_KEY=
EXECUTOR_API_KEY=
VERIFIER_API_KEY=
COMPUTER_API_KEY=

# Distinct models by agent. Verify exact model IDs in your NVIDIA account.
ORCHESTRATOR_MODEL=nvidia/nemotron-3-ultra-550b-a55b
PLANNER_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
EXECUTOR_MODEL=nvidia/nemotron-3.5-bolt-e4b
VERIFIER_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
COMPUTER_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

MAX_TOKENS=1800
TEMPERATURE=0.2
AGENT_TIMEOUT_SECONDS=120

# Local screenshot diagnostics (may contain private information)
DEBUG_SOM=False
